# Copy to .env and fill in. .env is gitignored and must stay that way - a key
# committed to a public repository is a key you have to rotate.
#
# A .env here overrides the machine's environment on purpose. OPENAI_API_KEY is
# often already set globally for some other project, and the wrong key fails
# confusingly: it authenticates fine, lists models fine, and then reports no
# credits remaining, which looks like a billing problem rather than the wrong
# key. Setting it per project removes the ambiguity.
#
# Use the same key the deployment uses, so what you measure locally is what
# students get. In Render: your service, Environment tab, OPENAI_API_KEY,
# reveal and copy.
OPENAI_API_KEY=sk-proj-replace-me

# Everything below is optional. Defaults are in config.py and are the values
# the README's numbers were measured against.

# Answering model. gpt-4.1 was chosen on measured time to first token, 211 ms
# ahead of gpt-4o with a much tighter tail. Reverting is a value change here
# rather than a deploy.
# VRHS_CHAT_MODEL=gpt-4.1

# Grader for claim grounding. Deliberately not the answering model.
# VRHS_GRADER_MODEL=gpt-4o-mini

# Retrieval gate. Calibrated for text-embedding-ada-002 on this corpus; these
# do not transfer to another embedding model.
# VRHS_SIMILARITY_SOLID=0.79
# VRHS_SIMILARITY_WEAK=0.78

# Skips the boot warm-up. The eval harnesses set this themselves so that
# importing main does not fire a network call.
# VRHS_NO_WARM=1

# VRHS_LOG_LEVEL=INFO
